{
    "name": "collab-docs",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"No tests specified yet\" && exit 0",
        "lint": "npm run lint --prefix server && npm run lint --prefix client",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Chhatarapati-Chandril/collab-docs.git"
    },
    "keywords": [],
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Chhatarapati-Chandril/collab-docs#readme"
    },
    "homepage": "https://github.com/Chhatarapati-Chandril/collab-docs#readme",
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0"
    },
    "lint-staged": {
        "server/**/*.ts": [
            "cd server && npx eslint --fix",
            "cd server && npx prettier --write"
        ],
        "client/**/*.ts": [
            "cd client && npx eslint --fix",
            "cd client && npx prettier --write"
        ],
        "server/**/*.{json,md,html,scss}": [
            "cd server && npx prettier --write"
        ],
        "client/**/*.{json,md,html,scss}": [
            "cd client && npx prettier --write"
        ]
    }
}